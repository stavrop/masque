<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed. Needs outgoing network to reach idmsa.apple.com / *.icloud.com. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Hardware security keys: Apple accounts with keys registered complete 2FA
	     with a WebAuthn assertion, which means talking CTAP2 to the key over USB
	     HID (see CTAPHIDDevice.swift). Verified sufficient — a sandboxed build
	     with this entitlement can enumerate, open and transact with the key. -->
	<key>com.apple.security.device.usb</key>
	<true/>
</dict>
</plist>
